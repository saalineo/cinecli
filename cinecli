#!/usr/bin/env bash
set -euo pipefail

BASE_URL="https://yts.mx"
OUTDIR="$HOME/Downloads"

check_deps() {
  for cmd in curl fzf webtorrent mpv; do
    if ! command -v "$cmd" &>/dev/null; then
      echo "missing: $cmd" >&2
      exit 1
    fi
  done
}

encode() {
  local s="$1" i c
  for ((i=0; i<${#s}; i++)); do
    c="${s:i:1}"
    case "$c" in
      [a-zA-Z0-9.~_-]) printf '%s' "$c" ;;
      ' ') printf '+' ;;
      *) printf '%%%02X' "'$c" ;;
    esac
  done
}

search() {
  local query="$1" html slugs titles years i

  html=$(curl -sLf --connect-timeout 10 --max-time 30 \
    "${BASE_URL}/browse-movies/$(encode "$query")") || {
    echo "no results for '$query'" >&2
    exit 1
  }

  # YTS movie cards use browse-movie-title and browse-movie-year classes.
  # These selectors break when YTS updates their template — check periodically.
  mapfile -t slugs < <(echo "$html" | grep -oP '<a class="browse-movie-title" href="\K[^"]+')
  mapfile -t titles < <(echo "$html" | grep -oP '<a class="browse-movie-title"[^>]*>\K[^<]+')
  mapfile -t years < <(echo "$html" | grep -oP '<div class="browse-movie-year">\K[^<]+')

  if [[ ${#slugs[@]} -eq 0 ]]; then
    echo "no results for '$query'" >&2
    exit 1
  fi

  for ((i=0; i<${#slugs[@]}; i++)); do
    printf '%s\t%s\t%s\n' "${titles[$i]}" "${years[$i]}" "${slugs[$i]}"
  done
}

quality() {
  local slug="$1" html qualities magnets i

  html=$(curl -sLf --connect-timeout 10 --max-time 30 "${BASE_URL}${slug}") || {
    echo "failed to load movie page" >&2
    exit 1
  }

  # Each download-list-item has a <p class="quality"> and a magnet link
  mapfile -t qualities < <(echo "$html" | grep -oP '<p class="quality">\K[^<]+')
  mapfile -t magnets < <(echo "$html" | grep -oP 'href="\K(magnet:[^"]+)')

  if [[ ${#magnets[@]} -eq 0 ]]; then
    echo "no magnets found on page" >&2
    exit 1
  fi

  for ((i=0; i<${#magnets[@]}; i++)); do
    printf '%s\t%s\n' "${qualities[$i]:-unknown}" "${magnets[$i]}"
  done
}

main() {
  check_deps

  [[ $# -ne 1 ]] && { echo "usage: cinecli <search>" >&2; exit 1; }

  selected=$(search "$1" | fzf --delimiter='\t' --with-nth=1,2 --prompt='[Select Movie]> ')
  [[ -z "$selected" ]] && exit 0
  slug=$(cut -f3 <<< "$selected")

  choice=$(quality "$slug" | fzf --delimiter='\t' --with-nth=1 --prompt='[Select Quality]> ')
  [[ -z "$choice" ]] && exit 0
  magnet=$(cut -f2 <<< "$choice")

  action=$(printf 'stream\ndownload' | fzf --prompt='[Choose Action]> ')
  [[ -z "$action" ]] && exit 0

  if [[ "$action" == "stream" ]]; then
    webtorrent download "$magnet" --mpv --not-on-top --sequential
  else
    webtorrent download "$magnet" --out "$OUTDIR"
  fi
}

main "$@"
