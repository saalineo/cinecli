#!/usr/bin/env bash
set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
main_py="$here/cinecli.py"
cache=$(mktemp "${TMPDIR:-/tmp}/cinecli-results.XXXXXX")
trap 'rm -f "$cache"' EXIT

if [[ -d "$here/.venv" && -x "$here/.venv/bin/python3" ]]; then
  py="$here/.venv/bin/python3"
elif [[ -n "${VIRTUAL_ENV:-}" && -x "${VIRTUAL_ENV}/bin/python3" ]]; then
  py="${VIRTUAL_ENV}/bin/python3"
elif command -v python3 &>/dev/null; then
  py="python3"
else
  py="python"
fi

R='\033[0;31m'; G='\033[0;32m'; Y='\033[0;33m'; B='\033[0;34m'; N='\033[0m'

banner() {
  echo -e " ${G}cinecli${N} — search, stream & download movies and web series"
  echo
}
msg()  { echo -e " ${B}$1${N}"; }
ok()   { echo -e " ${G}$1${N}"; }
warn() { echo -e " ${Y}$1${N}" >&2; }
fail() { echo -e " ${R}$1${N}" >&2; }

render_search_progress() {
  local query="$1" mode="$2" line payload source state count
  local tty="/dev/stderr" interactive=0 started completed=0
  local clean_query
  clean_query=$(printf '%s' "$query" | tr -d '\000-\037\177')
  [[ -t 2 ]] && interactive=1
  declare -A source_state source_count

  draw() {
    [[ $interactive == 1 ]] || return
    local elapsed=$((SECONDS - started)) name display_count
    printf '\033[?25l\033[H\033[2J' > "$tty"
    printf '\033[1;38;5;81m  CINECLI\033[0m  \033[38;5;245mDISCOVERY\033[0m\n\n' > "$tty"
    printf '  \033[1m%s\033[0m  \033[38;5;245m· %s search · %ss elapsed\033[0m\n' "$clean_query" "$mode" "$elapsed" > "$tty"
    printf '  \033[38;5;245mSearching public indexes and collecting release metadata.\033[0m\n\n' > "$tty"
    printf '  \033[38;5;245mSOURCE                 STATUS                     RESULTS\033[0m\n' > "$tty"
    printf '  \033[38;5;240m─────────────────────────────────────────────────────────\033[0m\n' > "$tty"
    for name in yts eztv tpb x1337 solid galaxy nyaa lime dht; do
      [[ -z "${source_state[$name]:-}" ]] && continue
      display_count="${source_count[$name]:-—}"
      case "${source_state[$name]}" in
        searching) printf '  \033[38;5;111m%-22s\033[0m \033[38;5;220m%-26s\033[0m %s\n' "$name" "searching…" "$display_count" > "$tty" ;;
        complete)  printf '  \033[38;5;111m%-22s\033[0m \033[38;5;114m%-26s\033[0m %s\n' "$name" "complete" "$display_count" > "$tty" ;;
        *)         printf '  \033[38;5;111m%-22s\033[0m \033[38;5;203m%-26s\033[0m %s\n' "$name" "${source_state[$name]}" "$display_count" > "$tty" ;;
      esac
    done
    printf '\n  \033[38;5;245m%d source(s) completed · Ctrl-C cancels safely\033[0m\n' "$completed" > "$tty"
  }

  started=$SECONDS
  draw
  while IFS= read -r line; do
    if [[ "$line" == @@cinecli-progress@@* ]]; then
      payload=${line#@@cinecli-progress@@}
      IFS='|' read -r source state count <<< "$payload"
      source_state["$source"]="$state"
      source_count["$source"]="$count"
      [[ "$state" == "complete" || "$state" == "timed out" ]] && ((completed+=1))
      draw
    elif [[ $interactive == 1 ]]; then
      # Keep non-protocol diagnostics visible beneath the live surface.
      printf '\033[38;5;245m  %s\033[0m\n' "$line" > "$tty"
    else
      printf '  %s\n' "$line" >&2
    fi
  done
  if [[ $interactive == 1 ]]; then
    printf '\033[?25h\n' > "$tty"
  fi
}

usage() {
  cat <<EOF
usage: cinecli [options] <movie or tv name>

options:
  -s, --series, --tv     search TV series (aliases: --tv, tv)
  -l, --lang <lang>      filter by language:
                         english hindi tamil telugu malayalam kannada bengali
                         spanish french german japanese korean chinese russian
                         arabic portuguese italian turkish polish dutch
  -q, --quality <q>      quality preference (4k, 1080p, 720p, 480p)
  -d, --download         download instead of stream
  -o, --outdir <dir>     output directory (default: ~/Downloads)
  -n, --max <n>          max results per search (default: 50)
  --sub <lang>           download & load subtitles for stream (e.g. en, es, hi)
  -c, --check            run VPN / DNS-leak checks before searching
      --doctor            show readiness and configuration diagnostics
      --install-deps     install missing python packages
  -h, --help             show this help

examples:
  cinecli "inception"
  cinecli --lang hindi "3 idiots"
  cinecli --series "breaking bad"
  cinecli -s --lang korean "squid game"
  cinecli --download -q 1080p --outdir ~/Movies "interstellar"
EOF
}

cfg() { "$py" "$main_py" config "$1" 2>/dev/null || true; }

setup() {
  local need_player="$1"
  [[ -f "$main_py" ]] || { fail "missing $main_py"; exit 1; }
  for c in "$py" fzf; do
    command -v "$c" &>/dev/null || { fail "install '$c' first"; exit 1; }
  done
  if [[ "$need_player" == 1 ]] && ! command -v mpv &>/dev/null && ! command -v vlc &>/dev/null; then
    fail "install mpv or vlc for playback"
    exit 1
  fi
  if ! "$py" -c "import libtorrent" &>/dev/null 2>&1; then
    warn "python-libtorrent not found (required to stream/download)"
    warn "  pip install libtorrent     or     sudo apt install python3-libtorrent"
    if [[ -t 0 ]]; then
      read -r -p "  install via pip now? [y/N] " ans
      if [[ "${ans:-n}" =~ ^[Yy] ]]; then
        "$py" -m pip install --user libtorrent || warn "pip install failed; try your package manager"
      fi
    fi
  fi
}

install_deps() {
  msg "installing python packages..."
  "$py" -m pip install --user cloudscraper beautifulsoup4 feedparser rich pyyaml libtorrent || {
    fail "pip install failed"
    exit 1
  }
}

safety_checks() {
  local safety_json vpn dnsleak
  safety_json=$("$py" "$main_py" safety 2>/dev/null || echo "{}")
  vpn=$(printf '%s' "$safety_json" | "$py" -c "import json,sys; print(json.load(sys.stdin).get('vpn'))" 2>/dev/null || echo "None")
  dnsleak=$(printf '%s' "$safety_json" | "$py" -c "import json,sys; print(json.load(sys.stdin).get('dns_leak'))" 2>/dev/null || echo "None")
  if [[ "$vpn" == "False" ]]; then
    fail "VPN not connected — enable your VPN first (or set vpn_required: false in config)"
    exit 1
  fi
  if [[ "$vpn" == "True" ]]; then
    ok "vpn: active"
  else
    warn "vpn: not detected (skipping)"
  fi
  if [[ "$dnsleak" == "True" ]]; then
    warn "possible DNS leak detected"
  elif [[ "$dnsleak" == "False" ]]; then
    ok "dns: no leak detected"
  else
    warn "dns: not verified; use a controlled DNS-leak test"
  fi
}

main() {
  banner

  mode=movie
  download=0
  lang=""
  quality=""
  outdir=""
  max=""
  sub_lang=""
  check=0
  do_install=0
  query_parts=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -s|--series|--tv|-tv|tv) mode=tv; shift ;;
      -d|--download) download=1; shift ;;
      -l|--lang)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        lang="$2"; shift 2 ;;
      -q|--quality)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        quality="$2"; shift 2 ;;
      -o|--outdir)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        outdir="$2"; shift 2 ;;
      -n|--max|--max-results)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        max="$2"; shift 2 ;;
      --sub)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        sub_lang="$2"; shift 2 ;;
      -c|--check) check=1; shift ;;
      --install-deps) do_install=1; shift ;;
      --doctor) "$py" "$main_py" doctor; exit $? ;;
      -h|--help) usage; exit 0 ;;
      -*) usage >&2; exit 1 ;;
      *) query_parts+=("$1"); shift ;;
    esac
  done

  if [[ $do_install == 1 ]]; then
    install_deps
    [[ ${#query_parts[@]} -eq 0 ]] && exit 0
  fi
  [[ ${#query_parts[@]} -eq 0 ]] && { usage >&2; exit 1; }
  query="${query_parts[*]}"

  [[ $download == 1 ]] && setup 0 || setup 1

  [[ -z "$lang" ]]    && lang=$(cfg default_language)
  [[ -z "$quality" ]] && quality=$(cfg default_quality)
  [[ -z "$outdir" ]]  && outdir=$(cfg download_dir)
  [[ -z "$max" ]]     && max=$(cfg max_results)
  player=$(cfg player)
  [[ -z "$player" || "$player" == "null" ]] && player=mpv
  if [[ $download == 0 ]] && ! command -v "$player" &>/dev/null; then
    if command -v vlc &>/dev/null; then
      warn "configured player '$player' not found; using vlc"
      player=vlc
    else
      fail "configured player '$player' was not found"
      exit 1
    fi
  fi

  if [[ $check == 1 || "$(cfg vpn_required)" == "true" || "$(cfg dns_check)" == "true" ]]; then
    safety_checks
  fi

  msg "searching for: ${Y}${query}${N} [${mode}]"
  search_args=(search --mode "$mode")
  [[ -n "$lang" ]] && search_args+=(-l "$lang")
  [[ -n "$quality" ]] && search_args+=(-q "$quality")
  [[ -n "$max" ]] && search_args+=(--max-results "$max")
  search_args+=("$query")

  if CINECLI_TUI=1 "$py" "$main_py" "${search_args[@]}" > "$cache" \
     2> >(render_search_progress "$query" "$mode"); then
    rc=0
  else
    rc=$?
  fi

  if [[ $rc -ne 0 || ! -s "$cache" ]]; then
    fail "no results found for '$query'"
    if [[ -n "$lang" && "$lang" != "english" ]]; then
      warn "  tip: try without --lang, or check the spelling"
    else
      warn "  tip: check the spelling or try a different title"
    fi
    exit 1
  fi

  results=$(awk -F'|' '
    BEGIN { S = sprintf("%c", 31) }
    !seen[$2 SUBSEP $3]++ {
      y = ($3 != 0) ? " (" $3 ")" : ""
      e = ($8 != "") ? " [" $8 "]" : ""
      printf "%s%s%s\t%s%s%s\n", $2, y, e, $2, S, $3
    }' "$cache")

  msg "select a title:"
  sel=$(printf '%s\n' "$results" | fzf --delimiter=$'\t' --with-nth=1 --reverse --prompt='  ') \
    || { echo; ok "cancelled"; exit 0; }
  sel=${sel#*$'\t'}
  IFS=$'\x1f' read -r keytitle keyyear <<< "$sel"
  echo

  choices=$(awk -F'|' -v t="$keytitle" -v y="$keyyear" '
    $2 == t && $3 == y {
      printf "%s  [%s seeders]  %s  %s\t%s\n", $4, $7, $5, $1, $6
    }' "$cache")
  if [[ -z "$choices" ]]; then
    fail "no releases for that title"
    exit 1
  fi

  msg "select quality:"
  c=$(printf '%s\n' "$choices" | fzf --delimiter=$'\t' --with-nth=1 --reverse --prompt='  ') \
    || { echo; ok "cancelled"; exit 0; }
  echo
  h=${c#*$'\t'}
  [[ -n "$h" ]] || { fail "invalid selection"; exit 1; }

  if [[ "$keyyear" != "0" && -n "$keyyear" ]]; then
    dn="$keytitle $keyyear"
    yl=" ($keyyear)"
  else
    dn="$keytitle"
    yl=""
  fi

  echo -e " ${B}${keytitle}${N}${yl}"

  if [[ $download == 1 ]]; then
    msg "downloading to $outdir..."
    "$py" "$main_py" download --hash "$h" --title "$dn" --outdir "$outdir" || {
      fail "download failed"
      exit 1
    }
  else
    msg "starting stream..."
    mapfile -t tries < <(awk -F'|' -v t="$keytitle" -v y="$keyyear" '
      $2 == t && $3 == y && $6 != "" {
        printf "%s\t%s  [%s seeders]  %s  %s\n", $6, $4, $7, $5, $1
      }' "$cache")
    if [[ ${#tries[@]} -eq 0 ]]; then
      fail "no releases for that title"
      exit 1
    fi
    ordered=("$h")
    for t in "${tries[@]}"; do
      [[ "${t%%$'\t'*}" == "$h" ]] && continue
      ordered+=("${t%%$'\t'*}")
    done
    played=0
    for ch in "${ordered[@]}"; do
      [[ -n "$ch" ]] || continue
      label=$(awk -F'|' -v x="$ch" '$6 == x { print $4 "  [" $7 " seeders]  " $5 "  " $1; exit }' "$cache")
      ok "  trying: ${label:-release}"
      stream_cmd=("$py" "$main_py" stream --hash "$ch" --title "$dn" --player "$player")
      [[ -n "$sub_lang" ]] && stream_cmd+=(--sub "$sub_lang")
      if "${stream_cmd[@]}"; then
        played=1
        break
      fi
      warn "  unreachable; trying next release..."
    done
    if [[ $played -ne 1 ]]; then
      fail "streaming failed for all releases"
      exit 1
    fi
  fi
}

main "$@"
