#!/usr/bin/env bash
set -euo pipefail

outdir="${OUTDIR:-$HOME/Downloads}"
cache="/tmp/cinecli_$$.txt"
trap 'rm -f "$cache"' EXIT

here=$(dirname "$0")
search_py="$here/torrentsearch.py"
stream_js="$here/torrentstream.mjs"

tr="&tr=udp://tracker.opentrackr.org:1337/announce&tr=udp://tracker.torrent.eu.org:451/announce&tr=udp://open.stealth.si:80/announce&tr=udp://tracker.bittor.pw:1337/announce&tr=udp://exodus.desync.com:6969/announce&tr=udp://tracker.tiny-vps.com:6969/announce&tr=udp://retracker.lanta-net.ru:2710/announce&tr=udp://tracker.moeking.me:6969/announce&tr=udp://tracker.altrosky.nl:6969/announce&tr=https://tracker.ubt.nu:443/announce&tr=wss://tracker.openwebtorrent.com&tr=wss://tracker.bittorrent.com&tr=wss://tracker.fastcast.nz"

R='\033[0;31m'; G='\033[0;32m'; Y='\033[0;33m'; B='\033[0;34m'; N='\033[0m'

banner() {
  echo -e " ${G}cinecli${N} — search & download movies"
  echo
}
msg()  { echo -e " ${B}$1${N}"; }
ok()   { echo -e " ${G}$1${N}"; }
fail() { echo -e " ${R}$1${N}" >&2; }

setup() {
  [[ -f "$search_py" ]] || { fail "missing $search_py"; exit 1; }
  [[ -f "$stream_js" ]] || { fail "missing $stream_js"; exit 1; }

  for c in curl fzf python3 node; do
    command -v "$c" &>/dev/null || { fail "install $c first"; exit 1; }
  done

  command -v webtorrent &>/dev/null || {
    msg "installing webtorrent-cli..."
    npm install -g webtorrent-cli || { fail "npm install -g webtorrent-cli"; exit 1; }
  }
}

download() {
  local mg="$1"
  mkdir -p "$outdir"
  msg "downloading..."
  node "$stream_js" "$mg" download "$outdir"
  ok "saved to $outdir"
}

main() {
  banner
  setup

  [[ $# -ne 1 ]] && { echo "usage: ./cinecli <movie name>" >&2; exit 1; }

  msg "searching for: ${Y}$1${N}"
  python3 "$search_py" "$1" > "$cache" 2>/dev/null || {
    fail "Can't find '$1'. Check spelling or try a different search."
    exit 1
  }

  results=$(awk -F'|' '
    !v[$2,$3]++ {
      r = $9 ? " " $9 "/10" : ""
      printf "%s (%s)%s\t%s\n", $2, $3, r, $4
    }' "$cache")

  msg "select a movie:"
  s=$(echo "$results" | fzf --delimiter='\t' --with-nth=1 --prompt='  ') || { echo; ok "cancelled"; exit 0; }
  echo
  s=$(cut -f2 <<< "$s")

  choices=$(awk -F'|' -v s="$s" '$0 ~ s {printf "%s  [%s seeders]\t%s\n", $5, $7, $6}' "$cache")
  msg "select quality:"
  c=$(echo "$choices" | fzf --delimiter='\t' --with-nth=1 --prompt='  ') || { echo; ok "cancelled"; exit 0; }
  echo
  h=$(cut -f2 <<< "$c")

  l=$(grep -F "|$s|" "$cache" | head -1)
  title=$(cut -d'|' -f2 <<< "$l")
  year=$(cut -d'|' -f3 <<< "$l")
  e=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$title $year")
  mg="magnet:?xt=urn:btih:$h&dn=$e$tr"

  echo -e " ${B}$title${N} ($year)"
  download "$mg"
}

main "$@"
